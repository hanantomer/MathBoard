{
  "compilerOptions": {
    "preserveConstEnums": true,
    "composite": true,
    "sourceMap": true,
    "target": "esnext",
    "useDefineForClassFields": true,
    "module": "esnext",
    "moduleResolution": "Node",
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "lib": ["ESNext"],
    "skipLibCheck": true,
    "noImplicitThis": false
  },
  "files": [],
  "references": [
    { "path": "./math-common" },
    { "path": "./math-db" },
    { "path": "./math-auth" },
    { "path": "./math-server" },
    { "path": "./math-messages" }
  ],
  "exclude": ["node_modules"]
}
